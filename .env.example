# Map Provider Configuration
# Default production renderer (no Google Maps billing required):
VITE_MAP_PROVIDER=leaflet

# CARTO Basemaps API key (required by basemaps.cartocdn.com for Dark Matter tiles)
VITE_CARTO_BASEMAPS_API_KEY=

# Optional: Google Maps JavaScript API (requires Google Cloud Billing enabled)
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAP_ID=

# Optional: Mappls / MapmyIndia SDK
# VITE_MAPMYINDIA_API_KEY=
